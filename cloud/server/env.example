NODE_ENV=development
HOST=0.0.0.0
PORT=4210
LOG_LEVEL=info
CORS_ORIGIN=*

DATABASE_URL=postgres://ipm:ipm_dev_password@localhost:5432/ipm_cloud

# Aliyun OSS private bucket config.
# Keep these credentials on the server only. Desktop clients should use signed URLs or STS later.
OSS_REGION=oss-cn-shanghai
OSS_BUCKET=your-ipm-cloud-bucket
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
# Optional custom endpoint, usually leave blank.
# OSS_ENDPOINT=
